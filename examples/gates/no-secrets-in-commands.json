// Example 8 — secrets never ride in command lines. Teaches: regex
// alternation, and that prevention is a deny, not a warning. A
// credential pasted into a command is now in logs, transcripts, and
// her permanent record — she stops it before the ink dries. (The
// advanced pack watches written files for the same patterns: defense
// in depth is fenced twice, on purpose.)
{
  "id": "no-secrets-in-commands",
  "name": "Credentials in a command line are a filing event",
  "description": "AWS keys, API tokens, and private key blocks in commands: instant deny.",
  "event": "PreToolUse",
  "priority": 95,
  "enabled": true,
  "tags": ["security", "secrets"],

  "match": {
    "all": [
      { "type": "command_regex", "pattern": "AKIA[0-9A-Z]{16}|sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36}|xox[baprs]-[0-9a-zA-Z-]{10,}|-----BEGIN\\s+(RSA\\s+|EC\\s+|OPENSSH\\s+)?PRIVATE KEY-----" }
    ]
  },

  "action": {
    "type": "deny",
    "reason": "A credential appeared in a command. That string is now in logs, transcripts, and her permanent record — rotate the secret, then pass it via your secret store instead of the command line."
  }
}
